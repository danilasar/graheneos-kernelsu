diff --git a/build/kernel/_setup_env.sh b/build/kernel/_setup_env.sh
index 087040e54ca74cc3616f40f99a69844183ccaae8..368fdb79aa247bb9e90982797271860ba52b2cc7 100644
--- a/build/kernel/_setup_env.sh
+++ b/build/kernel/_setup_env.sh
@@ -264,6 +264,13 @@ if [ -n "${DTC}" ]; then
   tool_args+=("DTC=${DTC}")
 fi
 
+# Bazel sandboxes omit nested .git metadata. Pin the KSU release and the
+# locally rebuilt Manager signer/package used for the GrapheneOS seccomp test.
+tool_args+=("KSU_GIT_VERSION=3294" "KSU_GIT_TAG=v3.4.0" "KSU_GIT_VERSION_VALID=1")
+tool_args+=("KSU_NEXT_MANAGER_SIZE=0x2e8")
+tool_args+=("KSU_NEXT_MANAGER_HASH=729b3cc73dd52b1eb06e5f99ade350c097827e3976c2f8bf26ca68c354d69239")
+tool_args+=("KSU_MANAGER_PACKAGE=com.rifsxd.ksunext.prctl")
+
 export TOOL_ARGS="${tool_args[@]}"
 
 export DECOMPRESS_GZIP DECOMPRESS_LZ4 RAMDISK_COMPRESS RAMDISK_DECOMPRESS RAMDISK_EXT
